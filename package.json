{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 tools/build_site.py && python3 tools/features/build.py",
    "test": "node tests/run.mjs",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:site": "wrangler pages deploy site --project-name=ledgerline --branch=main --commit-dirty=true"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "wrangler": "4.152.0"
  }
}
